<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<jsp:useBean id="now" class="java.util.Date" scope="request"/>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><c:out value="${pageTitle != null ? pageTitle : 'Primary School Admin'}"/></title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-slate-50 text-slate-900">
<nav class="bg-sky-900 text-white shadow">
    <div class="mx-auto max-w-6xl px-4 py-4 flex items-center justify-between">
        <a href="${pageContext.request.contextPath}/dashboard" class="text-lg font-semibold tracking-wide">
            Primary School Admin
        </a>
        <div class="flex items-center gap-4 text-sm">
            <a href="${pageContext.request.contextPath}/students" class="hover:text-slate-200">Students</a>
            <a href="${pageContext.request.contextPath}/teachers" class="hover:text-slate-200">Teachers</a>
            <a href="${pageContext.request.contextPath}/classes" class="hover:text-slate-200">Classes</a>
            <c:choose>
                <c:when test="${not empty sessionScope.loggedInUser}">
                    <span class="text-slate-200">Hi, <c:out value="${sessionScope.loggedInUser.username}"/></span>
                    <a href="${pageContext.request.contextPath}/auth/logout"
                       class="rounded bg-rose-600 px-3 py-1 text-white hover:bg-rose-500">Logout</a>
                </c:when>
                <c:otherwise>
                    <a href="${pageContext.request.contextPath}/auth/login"
                       class="rounded bg-emerald-600 px-3 py-1 text-white hover:bg-emerald-500">Login</a>
                </c:otherwise>
            </c:choose>
        </div>
    </div>
</nav>
<main class="mx-auto max-w-6xl px-4 py-8">

